{
  "name": "@lijuhong1981/cesium.utils",
  "version": "0.4.0",
  "description": "Cesium 公共工具库：Cesium 类扩展（revisions）、值解析（parses）、坐标/矩阵变换、通用工具函数",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./dist/*": "./dist/*"
  },
  "unpkg": "dist/cesium.utils.min.js",
  "jsdelivr": "dist/cesium.utils.min.js",
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "npm run build",
    "docs": "jsdoc -c jsdoc.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "keywords": [
    "cesium",
    "cesiumjs",
    "3d",
    "webgl",
    "gis",
    "geospatial",
    "map",
    "globe",
    "3d-tiles",
    "coordinate",
    "transform",
    "toolkit",
    "utils"
  ],
  "license": "MIT",
  "peerDependencies": {
    "cesium": ">=1.107.0"
  },
  "dependencies": {
    "@lijuhong1981/jscheck": "^1.1.8",
    "@lijuhong1981/jsdestroy": "^1.2.8",
    "@lijuhong1981/jslib": "^1.3.2",
    "@lijuhong1981/jsmath": "^1.3.7"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "cesium": ">=1.107.0",
    "docdash": "^2.0.2",
    "jsdoc": "^4.0.5",
    "rollup": "^4.64.6"
  }
}
