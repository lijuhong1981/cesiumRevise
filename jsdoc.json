{
    "source": {
        "include": [
            "src/additions",
            "src/defines",
            "src/materials",
            "src/parses",
            "src/primitives",
            "src/revisions",
            "src/tiles",
            "src/utils"
        ],
        "exclude": [
            "src/utils/Scratch.js"
        ]
    },
    "opts": {
        "destination": "docs",
        "recurse": true,
        "template": "node_modules/docdash",
        "readme": "./README.md"
    },
    "plugins": [
        "plugins/markdown"
    ],
    "docdash": {
        "static": true,
        "sort": true,
        "search": true,
        "typedefs": true,
        "collapse": true
    }
}
